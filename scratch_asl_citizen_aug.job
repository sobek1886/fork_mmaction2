#!/bin/bash
# FROM-SCRATCH baseline (CE + augmentation-as-data): train MViTv2-S on ASL-Citizen
# ORIGINAL + AUGMENTED videos with RANDOM INIT (NO Logos checkpoint). Mirror of
# scratch_asl_citizen_ce.job but with the run3 aug-as-data recipe (extra training
# rows in splits_aug/train.csv; no loss change — augs are just more data).
# Purpose: with a from-scratch model that (presumably) has headroom, test whether
# augmentation-as-data helps when the recipe is NOT saturated by pretraining.
#
# Random init mechanism + init caveat + LR question: identical to
# scratch_asl_citizen_ce.job — see that file's header and scratch-baseline-prep.md.
#
# NOT SUBMITTED — prepared only, gated on Piotr's SBU request. Do not sbatch.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=scratch_asl_aug
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=72:00:00              # ~45 GPU-h expected (aug=1.6x data, 64,154 rows, full
                                     # unfreeze, 30 ep + extract). gpu_a100 max 5 days.
                                     # Reduced (SUBSET=half) needs only ~24h.
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1

# ── run config ───────────────────────────────────────────────────────────────
TAG=scratch_aug
UNFREEZE=16          # full network — mandatory for random init
LR=1e-3              # SAME-LR baseline. Same OPEN LR question as CE job:
                     #   ALT-A (safer, 10x lower): LR=1e-4 ; ALT-B (10x higher): LR=1e-2
LLRD=1.0
BATCH=6
GRAD_ACCUM=4
EPOCHS=30            # match the CE from-scratch run for a fair aug-vs-noaug comparison

# ── reduced-set toggle (50% stratified train subset) ─────────────────────────
# "half" uses splits_half_aug/train.csv = the aug rows built ON TOP of the 50%
# stratified originals (see make_asl_citizen_train_subset.py + artifact §3).
SUBSET=""            # "" = full aug train ; "half" = aug over 50% originals
if [ "$SUBSET" = "half" ]; then
    SPLITS_AUG=$HOME/ASL_Citizen/splits_half_aug
    TAG=${TAG}_half
else
    SPLITS_AUG=$HOME/ASL_Citizen/splits_aug
fi

VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames_512
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt

# ── synthesise the empty (backbone-key-less) checkpoint for random init ───────
EMPTY_CKPT=$HOME/fork_mmaction2/data/model/EMPTY_random_init.pth
if [ ! -f "$EMPTY_CKPT" ]; then
    python -c "import torch, os; os.makedirs(os.path.dirname('$EMPTY_CKPT'), exist_ok=True); torch.save({'state_dict': {}}, '$EMPTY_CKPT')"
    echo "[random-init] wrote empty checkpoint $EMPTY_CKPT (loads no weights)"
fi

# ── train (random init + aug-as-data) ────────────────────────────────────────
srun python train_logos_asl_citizen.py \
    --train_csv      $SPLITS_AUG/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES --aug_frame_interval 1 \
    --aug_names glasses shirt_1 signer_swap skin_mst_diffusion \
    --checkpoint     $EMPTY_CKPT \
    --save_dir       $SAVE_DIR \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum $GRAD_ACCUM --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG} --slurm_log "$LOGFILE" \
    --val_csv $HOME/ASL_Citizen/splits/val.csv

# ── re-extract all videos with the from-scratch checkpoint (Eval A + Eval B) ─
srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc logos_native --overwrite \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — now run eval_asl_citizen_features.job (MMPT venv, genoa)."

RUNID=$(cat $SAVE_DIR/mlflow_run_id.txt 2>/dev/null)
[ -n "$RUNID" ] && python mlflow_log_slurm_log.py "$RUNID" "$LOGFILE" || true
