#!/bin/bash
# Re-extract ASL-Citizen features from the ORIGINAL (un-fine-tuned) Logos checkpoint
# using the CORRECT aspect-preserving preprocessing (logos_native: resize long->300,
# pad to 300x300 grey-114, center-crop 224) + the existing end-anchor clip logic.
#
# This is the honest baseline for the fine-tuning runs (run1/2/3), which re-extract
# with the same --preproc logos_native. The old baseline/endanchor dirs used direct224
# (aspect-distorting on non-square ASL-Citizen) so they are NOT the matched reference.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=logos_extract_native
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate

srun python extract_logos_features.py \
    --video_dir    /scratch-shared/psobecki/ASL_Citizen/videos \
    --output_dir   /scratch-shared/psobecki/ASL_Citizen/logos_features_native \
    --checkpoint   $HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth \
    --dataset_name asl_citizen \
    --preproc logos_native \
    --workers 16 --batch_size 8

echo "Done. baseline_native features in /scratch-shared/psobecki/ASL_Citizen/logos_features_native"
echo "Evaluate via jobs/eval_asl_citizen_features.job (MMPT venv)."
