#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=logos_piotranims
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=04:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_logos_piotranims_%A.txt

# NGT Flux-vs-Unreal ladder: real videos are 60 fps; --frame_interval 4 gives
# the ladder's common effective 15 fps (matching the 15 fps Flux frames at
# interval 1). Output goes to a NEW _15fps dir so the original 30 fps-effective
# features (logos_features, used by the old Table-5 runs) stay reproducible.

module purge
module load 2025

cd $HOME/fork_mmaction2
source .venv/bin/activate

srun python extract_logos_features.py \
    --video_dir   /scratch-shared/psobecki/piotrAnims/mkv_cropped \
    --output_dir  /scratch-shared/psobecki/piotrAnims/logos_features_15fps \
    --checkpoint  $HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth \
    --dataset_name piotr_anims \
    --frame_interval 4 \
    --workers 5 \
    --batch_size 8
