#!/bin/bash
# Run 1 variant — SHIRT_1 ONLY: CE + appearance-consistency pulling each original toward
# its *shirt_1* augmentation only (isolates the shirt effect from glasses).
# Mirrors ft_asl_citizen_run1_consistency.job but --aug_names shirt_1.
# FULL FT: UNFREEZE=16 LR=1e-5 LLRD=0.75 BATCH=10 GRAD_ACCUM=4 EPOCHS=15 TAG=run1_shirt1_full

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_run1_shirt1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate

TAG=run1_shirt1
UNFREEZE=2
LR=1e-3
LLRD=1.0
BATCH=12           # 1 aug/item (vs 2 in the combined run) → a bit more headroom
GRAD_ACCUM=1
EPOCHS=10
LAMBDA_CONSIST=0.5

CKPT=$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth
VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames
SPLITS=$HOME/ASL_Citizen/splits
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}

srun python train_logos_asl_citizen.py \
    --train_csv      $SPLITS/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES \
    --aug_names      shirt_1 \
    --checkpoint     $CKPT \
    --save_dir       $SAVE_DIR \
    --paired --lambda_consist $LAMBDA_CONSIST \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum $GRAD_ACCUM --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG}

srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_last.pt \
    --dataset_name asl_citizen \
    --preproc logos_native \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — eval via jobs/eval_asl_citizen_features.job."
