#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=analyse_asl_aug_frames
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_analyse_asl_aug_frames_%A.txt

module purge
module load 2025

cd $HOME/fork_mmaction2
source .venv/bin/activate

python - <<'EOF'
from pathlib import Path
import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import cv2

# ── augmented frame sequences ────────────────────────────────────────────────
aug_root = Path('/scratch-shared/psobecki/ASL_Citizen/augmented_frames')

aug_counts = []
for video_dir in sorted(aug_root.iterdir()):
    if not video_dir.is_dir():
        continue
    for aug_dir in sorted(video_dir.iterdir()):
        if not aug_dir.is_dir():
            continue
        n = len(list(aug_dir.glob('*.jpg')))
        if n > 0:
            aug_counts.append(n)

aug_counts = np.array(aug_counts)

print('=== Augmented sequences ===')
print(f'Sequences analysed : {len(aug_counts)}')
print(f'Min                : {aug_counts.min()}')
print(f'Max                : {aug_counts.max()}')
print(f'Mean               : {aug_counts.mean():.1f}')
print(f'Median             : {np.median(aug_counts):.1f}')
print(f'Std                : {aug_counts.std():.1f}')
print(f'Pct < 64 frames    : {(aug_counts < 64).mean()*100:.1f}%  ({(aug_counts < 64).sum()} seqs)')
print(f'Pct < 32 frames    : {(aug_counts < 32).mean()*100:.1f}%  ({(aug_counts < 32).sum()} seqs)')

# ── original videos (random sample) ──────────────────────────────────────────
import random
from concurrent.futures import ThreadPoolExecutor

vid_root = Path('/scratch-shared/psobecki/ASL_Citizen/videos')
all_vids = sorted(vid_root.rglob('*.mp4'))
random.seed(42)
sample_vids = random.sample(all_vids, min(2000, len(all_vids)))
print(f'\nSampling {len(sample_vids)} of {len(all_vids)} original videos')

def get_frame_count(vpath):
    cap = cv2.VideoCapture(str(vpath))
    n = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    cap.release()
    return n

with ThreadPoolExecutor(max_workers=4) as ex:
    orig_counts = [n for n in ex.map(get_frame_count, sample_vids) if n > 0]

orig_counts = np.array(orig_counts)

print('\n=== Original videos ===')
print(f'Videos analysed    : {len(orig_counts)}')
print(f'Min                : {orig_counts.min()}')
print(f'Max                : {orig_counts.max()}')
print(f'Mean               : {orig_counts.mean():.1f}')
print(f'Median             : {np.median(orig_counts):.1f}')
print(f'Std                : {orig_counts.std():.1f}')
print(f'Pct < 64 frames    : {(orig_counts < 64).mean()*100:.1f}%  ({(orig_counts < 64).sum()} videos)')
print(f'Pct < 32 frames    : {(orig_counts < 32).mean()*100:.1f}%  ({(orig_counts < 32).sum()} videos)')

# ── plot ──────────────────────────────────────────────────────────────────────
fig, axes = plt.subplots(2, 2, figsize=(14, 9))

def plot_hist(ax, counts, title, color):
    ax.hist(counts, bins=60, color=color, edgecolor='white', linewidth=0.4)
    ax.axvline(counts.mean(),        color='red',    linestyle='--', label=f'mean {counts.mean():.0f}')
    ax.axvline(np.median(counts),    color='orange', linestyle='--', label=f'median {np.median(counts):.0f}')
    ax.axvline(64, color='green', linestyle=':', label='effective_span=64')
    ax.set_xlabel('Frame count')
    ax.set_ylabel('Count')
    ax.set_title(title)
    ax.legend()

def plot_cdf(ax, counts, title, color):
    ax.hist(counts, bins=60, color=color, edgecolor='white', linewidth=0.4,
            cumulative=True, density=True)
    ax.axvline(64, color='green', linestyle=':', label='effective_span=64')
    ax.set_xlabel('Frame count')
    ax.set_ylabel('Cumulative fraction')
    ax.set_title(title)
    ax.legend()

plot_hist(axes[0, 0], aug_counts,  'Augmented sequences — histogram', 'steelblue')
plot_cdf (axes[0, 1], aug_counts,  'Augmented sequences — CDF',       'steelblue')
plot_hist(axes[1, 0], orig_counts, f'Original videos — histogram (n={len(orig_counts)} sample)', 'coral')
plot_cdf (axes[1, 1], orig_counts, f'Original videos — CDF (n={len(orig_counts)} sample)',       'coral')

out = Path('/home/psobecki/fork_mmaction2/jobs/output/asl_citizen_frame_counts.png')
plt.tight_layout()
plt.savefig(out, dpi=150)
print(f'\nPlot saved to {out}')
EOF
