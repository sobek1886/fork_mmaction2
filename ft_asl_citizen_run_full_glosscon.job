#!/bin/bash
# FULL end-to-end fine-tune + GLOSS-LEVEL contrastive on the CLS token (supervisor's ask:
# "train the backbone with the contrastive goal at the CLS token, unfreeze everything").
# Positives for a video = all SAME-GLOSS videos in the batch (across signers) AND their
# augmentations; negatives = every other gloss. This is supervised contrastive (SupCon) =
# the correct multi-positive generalisation of SignCLIP's InfoNCE, applied video-to-video.
#
# Two pieces make it work:
#   --gloss_balanced --per_gloss 2  : batches are class-balanced by gloss, so each anchor has a
#                                     same-gloss positive in the batch (random batching over 2731
#                                     glosses would give ~none). per_gloss=2 maximises the number
#                                     of distinct-gloss negatives at a fixed (memory-limited) batch.
#   --paired --lambda_supcon 1.0    : brings each video's augmentations into the batch and runs
#                                     supcon_loss over [originals; augs] with GLOSS labels.
#
# NOTE: full unfreeze is activation-heavy, so the batch (hence #negatives) is small — the main
# limit on this experiment. Raise BATCH if memory allows (more negatives = stronger contrastive);
# if OOM, lower it. Preprocessing: direct224. CE is kept alongside SupCon for head/discriminability.

# NOTE: must be gpu_h100 (94 GB). Full unfreeze costs ~3.4 GB of activations PER 32-frame clip;
# the 40 GB A100 can't even fit batch 8 (needs ~48 GB). See probe_batch_size_capped.job.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_run_full_glosscon
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=40:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1
# Reduce allocator fragmentation (the capped probe showed FITs with several GB free that still
# failed on one large contiguous block).
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

TAG=run_full_glosscon
UNFREEZE=16
LR=2e-4
LLRD=0.9
# Forward size is bounded: B originals + at most B*MAXAUG augs. With MAXAUG=1 the augs are mostly
# redundant same-gloss positives, so capping them frees memory for MORE distinct glosses
# (= more SupCon negatives, the scarce resource).
# Sizing with GRAD CHECKPOINTING on (smoke ft_asl_citizen_smoke_glosscon_realbatch.job): activation
# cost drops to ~1.4 GB/clip (vs 3.42 without), so worst-case N=2*B is cheap:
#   B=16 → N=32 → ~48 GB  | B=24 → N=48 → ~72 GB  | B=28 → N=56 → ~84 GB (tight) on the 94 GB H100.
# B=24 (12 glosses/batch) for more SupCon negatives; worst-case N=48 → ~72 GB leaves comfortable
# headroom on the 94 GB H100. (Without --grad_checkpointing the ceiling would be ~12; do not drop
# the flag without re-sizing.)
BATCH=24
PER_GLOSS=2
MAXAUG=1
LAMBDA_SUPCON=1.0
EPOCHS=10

CKPT=$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth
VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames
SPLITS=$HOME/ASL_Citizen/splits
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt

srun python train_logos_asl_citizen.py \
    --train_csv      $SPLITS/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES \
    --aug_names      glasses shirt_1 signer_swap skin_mst_diffusion \
    --checkpoint     $CKPT \
    --save_dir       $SAVE_DIR \
    --orig_preproc direct224 --aug_preproc direct224 \
    --paired --gloss_balanced --per_gloss $PER_GLOSS --lambda_supcon $LAMBDA_SUPCON \
    --max_augs_per_item $MAXAUG \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD --grad_checkpointing \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum 1 --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG} --slurm_log "$LOGFILE" \
    --val_csv $HOME/ASL_Citizen/splits/val.csv

srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc direct224 --overwrite \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — add 'run_full_glosscon' to eval_asl_citizen_features.job FEATS."
RUNID=$(cat $SAVE_DIR/mlflow_run_id.txt 2>/dev/null)
[ -n "$RUNID" ] && python mlflow_log_slurm_log.py "$RUNID" "$LOGFILE" || true
