#!/bin/bash
# Frozen baseline (ORIGINAL checkpoint, no fine-tuning) extracted with letterbox224.
# For the preprocessing comparison: baseline_letterbox vs baseline_endanchor (direct224)
# vs baseline_native (logos_native). No training — just feature extraction + eval.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=logos_extract_letterbox
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=8:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate

srun python extract_logos_features.py \
    --video_dir    /scratch-shared/psobecki/ASL_Citizen/videos \
    --output_dir   /scratch-shared/psobecki/ASL_Citizen/logos_features_letterbox \
    --checkpoint   $HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth \
    --dataset_name asl_citizen \
    --preproc letterbox224 \
    --workers 16 --batch_size 8

echo "Done. baseline_letterbox features in /scratch-shared/psobecki/ASL_Citizen/logos_features_letterbox"
echo "Evaluate via jobs/eval_asl_citizen_preproc.job (MMPT venv)."
