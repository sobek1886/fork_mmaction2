#!/bin/bash
# TWO-STAGE (mirrors the SignCLIP recipe that worked on ASL-Citizen):
#   Stage 1 = run2_direct224 (CE fine-tune from the Logos init → converged baseline).  [run first]
#   Stage 2 = THIS job: resume that checkpoint (backbone + head via --load_head), drop LR 100x,
#             add the appearance-consistency term, reset the optimizer, train ~10 epochs.
# Tests whether the augmentation/invariance benefit materialises only AFTER a converged
# ASL-Citizen baseline (as it did for SignCLIP), rather than from the Logos init (= run1).
# Preprocessing: direct224 (keeps all content).
# PREREQ: ft_asl_citizen_run2_direct224.job has finished (provides the stage-1 checkpoint).

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_twostage
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1

TAG=twostage
STAGE1=/scratch-shared/psobecki/runs/asl_ft_run2_direct224/checkpoint_best.pt
UNFREEZE=2
LR=1e-5            # 100x below stage-1's 1e-3 — gentle, resuming a converged model
LLRD=1.0
BATCH=6
GRAD_ACCUM=1
EPOCHS=10
LAMBDA_CONSIST=0.5

VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames
SPLITS=$HOME/ASL_Citizen/splits
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt

srun python train_logos_asl_citizen.py \
    --train_csv      $SPLITS/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES \
    --aug_names      glasses shirt_1 signer_swap skin_mst_diffusion \
    --checkpoint     $STAGE1 --load_head \
    --save_dir       $SAVE_DIR \
    --paired --lambda_consist $LAMBDA_CONSIST \
    --orig_preproc direct224 --aug_preproc direct224 \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum $GRAD_ACCUM --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG} --slurm_log "$LOGFILE" \
    --val_csv $HOME/ASL_Citizen/splits/val.csv

srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc direct224 \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — eval via jobs/eval_asl_citizen_features.job."
RUNID=$(cat $SAVE_DIR/mlflow_run_id.txt 2>/dev/null)
[ -n "$RUNID" ] && python mlflow_log_slurm_log.py "$RUNID" "$LOGFILE" || true
