#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=logos_ngt_flux
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=12:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_logos_ngt_flux_%A.txt

# Extract Logos features from the Flux-augmented NGT frames (Flux-vs-Unreal
# comparison, experiment ladder E1-E10 — see make_ngt_singleview_manifest.py).
# Prereq: rsync nano_banana/output/flux-aug/ngt to
#   /scratch-shared/psobecki/NGT_flux/{date}/augmented_frames (see nano_banana
#   rsync scripts). ALL FOUR session batches are needed (the experiment uses the
#   full 4-signer train set).

module purge
module load 2025

cd $HOME/fork_mmaction2
source .venv/bin/activate

# Shared A100 slice (~40 GB); CLIP_LEN=32 @ 224x224 makes each clip heavy, so
# keep batch_size modest and let PyTorch grow segments to avoid fragmentation.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

srun python extract_logos_features_ngt_flux.py \
    --flux_root   /scratch-shared/psobecki/NGT_flux \
    --output_dir  /scratch-shared/psobecki/NGT_flux/logos_features \
    --checkpoint  $HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth \
    --dates       2025-11-26 2025-12-17 2026-01-29 2026-03-16 \
    --workers 5 \
    --batch_size 16
