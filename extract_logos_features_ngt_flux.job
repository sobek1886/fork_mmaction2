#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=logos_ngt_flux
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=12:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_logos_ngt_flux_%A.txt

# Extract Logos features from the Flux-augmented NGT frames (single-view
# Flux-vs-Unreal comparison, thesis story point 12).
# Prereq: rsync nano_banana/output/flux-aug/ngt to
#   /scratch-shared/psobecki/NGT_Flux/flux-aug/ngt (see nano_banana rsync
#   scripts). Only the 2026-03-16 batch (piotrAnims session) is needed —
#   its sign ids are the ones that match ngt_pair_manifest.json.

module purge
module load 2025

cd $HOME/fork_mmaction2
source .venv/bin/activate

srun python extract_logos_features_ngt_flux.py \
    --flux_root   /scratch-shared/psobecki/NGT_Flux/flux-aug/ngt \
    --output_dir  /scratch-shared/psobecki/NGT_Flux/logos_features \
    --checkpoint  $HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth \
    --dates       2026-03-16 \
    --workers 5 \
    --batch_size 64
