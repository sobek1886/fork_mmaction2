#!/bin/bash
# Smoke test for the backbone fine-tuning pipeline — cheap (~10 min, a few dozen SBU).
# Verifies, before committing GPU-days to the real FT runs:
#   1) CE path (run2/run3 shape): backbone loads, forward+backward runs, loss drops,
#      validation runs (val_top1/top5 logged) and checkpoint_best.pt is saved.
#   2) Paired path (run1 shape) with --require_augs: the consistency loss actually fires.
#   3) MLflow: metrics + the live .txt artifact actually reach the server (smoke_ce /
#      smoke_paired runs in the asl-citizen-backbone-ft experiment).
#   4) Train->extract handoff: checkpoint_best.pt re-extracts cleanly (2 videos).
# Green here ⇒ run1/2/3 are safe to submit.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_smoke
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:20:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1

CKPT=$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth
VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames
SPLITS=$HOME/ASL_Citizen/splits
SMOKE=/scratch-shared/psobecki/runs/asl_ft_smoke
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt
EXP=asl-citizen-backbone-ft

echo "########## 1) CE path (run2/run3 shape) + validation + MLflow artifact ##########"
srun python train_logos_asl_citizen.py --smoke \
    --train_csv  $SPLITS/train.csv \
    --video_dir  $VIDEO_DIR \
    --checkpoint $CKPT \
    --save_dir   $SMOKE/ce \
    --val_csv    $SPLITS/val.csv --val_max_videos 40 \
    --mlflow --mlflow_experiment $EXP --mlflow_run_name smoke_ce \
    --slurm_log "$LOGFILE" --artifact_every 1

echo ""
echo "########## 2) Paired path (run1 shape, consistency forced) ##########"
srun python train_logos_asl_citizen.py --smoke --paired --require_augs \
    --train_csv      $SPLITS/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES \
    --checkpoint     $CKPT \
    --save_dir       $SMOKE/paired \
    --val_csv        $SPLITS/val.csv --val_max_videos 40 \
    --mlflow --mlflow_experiment $EXP --mlflow_run_name smoke_paired \
    --slurm_log "$LOGFILE" --artifact_every 1

echo ""
echo "########## 3) Train->extract round-trip from checkpoint_best.pt (2 videos) ##########"
TINY=$SMOKE/tiny_videos
rm -rf "$TINY"; mkdir -p "$TINY"
find "$VIDEO_DIR" -maxdepth 1 -name '*.mp4' | head -2 | while read -r f; do ln -sf "$f" "$TINY/"; done
srun python extract_logos_features.py \
    --video_dir   "$TINY" \
    --output_dir  $SMOKE/tiny_feats \
    --checkpoint  $SMOKE/ce/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc logos_native --overwrite \
    --workers 4 --batch_size 4

echo ""
echo "########## result ##########"
ls -la $SMOKE/ce $SMOKE/paired $SMOKE/tiny_feats

echo ""
echo "PASS if ALL of:"
echo "  - checkpoint_best.pt AND checkpoint_last.pt exist in ce/ and paired/"
echo "  - logs show a '[val] epoch 0: ce=.. top1=.. top5=..' line (validation ran)"
echo "  - paired log shows 'batches with >=1 aug pair: N' (N>0)"
echo "  - logs show '[MLflow] logged artifact ...' (NOT 'could not log artifact')"
echo "  - .npy files exist in tiny_feats/  (best-checkpoint round-trip works)"
echo "  - MLflow 'asl-citizen-backbone-ft' shows runs smoke_ce / smoke_paired with the .txt artifact"
