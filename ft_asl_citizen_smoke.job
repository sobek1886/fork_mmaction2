#!/bin/bash
# Smoke test for the backbone fine-tuning pipeline — cheap (~10 min, a few dozen SBU).
# Verifies, before committing GPU-days to the real FT runs:
#   1) CE path (run2/run3 shape): backbone loads, forward+backward runs, loss drops, ckpt saves.
#   2) Paired path (run1 shape) with --require_augs: the appearance-consistency loss actually
#      fires (only ~10% of videos have augs, so we force paired-only here).
#   3) Train->extract handoff: the saved checkpoint re-extracts cleanly via the UNMODIFIED
#      extract_logos_features.py (filename + key-prefix contract), on 2 videos.
# A green run means the run1/2/3 jobs are safe to submit once budget lands.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_smoke
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:20:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate

CKPT=$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth
VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames
SPLITS=$HOME/ASL_Citizen/splits
SMOKE=/scratch-shared/psobecki/runs/asl_ft_smoke

echo "########## 1) CE path (run2/run3 shape) ##########"
srun python train_logos_asl_citizen.py --smoke \
    --train_csv  $SPLITS/train.csv \
    --video_dir  $VIDEO_DIR \
    --checkpoint $CKPT \
    --save_dir   $SMOKE/ce

echo ""
echo "########## 2) Paired path (run1 shape, consistency forced) ##########"
srun python train_logos_asl_citizen.py --smoke --paired --require_augs \
    --train_csv      $SPLITS/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES \
    --checkpoint     $CKPT \
    --save_dir       $SMOKE/paired

echo ""
echo "########## 3) Train->extract round-trip (2 videos) ##########"
TINY=$SMOKE/tiny_videos
rm -rf "$TINY"; mkdir -p "$TINY"
ls "$VIDEO_DIR"/*.mp4 | head -2 | while read -r f; do ln -sf "$f" "$TINY/"; done
srun python extract_logos_features.py \
    --video_dir   "$TINY" \
    --output_dir  $SMOKE/tiny_feats \
    --checkpoint  $SMOKE/ce/checkpoint_last.pt \
    --dataset_name asl_citizen \
    --preproc logos_native \
    --workers 4 --batch_size 4

echo ""
echo "########## result ##########"
ls -la $SMOKE/ce $SMOKE/paired $SMOKE/tiny_feats
echo ""
echo "PASS if: checkpoint_last.pt exists in ce/ and paired/, .npy files exist in tiny_feats/,"
echo "and the logs above show loss values + 'batches with >=1 aug pair: N' (N>0) for the paired run."
