#!/bin/bash
# Run 1 (PRIMARY intervention): fine-tune Logos MViTv2-S with CE + appearance-consistency.
# Iterates ORIGINAL train videos; for each, attaches ALL its augmented copies
# (augmented_frames/{id}/{glasses,shirt_1,signer_swap,skin_mst_diffusion}/) in the same
# batch item and adds
#   loss = CE(orig+augs) + lambda_consist * mean(1 - cos(f_aug, f_orig))
# pulling an original and its appearance-augmented versions together.
# Then re-extract features for Eval A + Eval B.
# FULL FT: UNFREEZE=16 LR=1e-5 LLRD=0.75 BATCH=4 GRAD_ACCUM=4 EPOCHS=15 TAG=run1_full
# (paired batches hold originals + up to 4x augs, so BATCH is low.)

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_run1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1   # keep the SLURM .txt current for live MLflow artifact uploads

TAG=run1
UNFREEZE=2
LR=1e-3
LLRD=1.0
BATCH=6            # originals/item; +up to 4x augs per paired item (≈30 clips/step)
GRAD_ACCUM=1
EPOCHS=10
LAMBDA_CONSIST=0.5

CKPT=$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth
VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames_512
SPLITS=$HOME/ASL_Citizen/splits
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt

srun python train_logos_asl_citizen.py \
    --train_csv      $SPLITS/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES --aug_frame_interval 1 \
    --checkpoint     $CKPT \
    --save_dir       $SAVE_DIR \
    --paired --lambda_consist $LAMBDA_CONSIST \
    --aug_names glasses shirt_1 signer_swap skin_mst_diffusion \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum $GRAD_ACCUM --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG} --slurm_log "$LOGFILE" \
    --val_csv $HOME/ASL_Citizen/splits/val.csv

srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc logos_native --overwrite \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — now run eval_asl_citizen_features.job (MMPT venv)."

# Attach the full SLURM log (.txt) to the MLflow training run as an artifact.
RUNID=$(cat $SAVE_DIR/mlflow_run_id.txt 2>/dev/null)
[ -n "$RUNID" ] && python mlflow_log_slurm_log.py "$RUNID" "$LOGFILE" || true
