#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=logos_bushuis
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=04:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_logos_bushuis_%A.txt

# NGT Flux-vs-Unreal ladder: Bushuis videos are ~60 fps (59.94);
# --frame_interval 4 gives the ladder's common effective 15 fps. Output goes
# to a NEW _15fps dir so the original features (logos_features, used by the
# old Table-5 runs) stay reproducible.
# Input: NGT_dataset/test — the 387 deduped test videos, ALREADY square-
# cropped locally (1252x1252, crop_bushuis_videos.py on the workstation,
# 2026-07-16) and rsynced from Data/ngt_test_cropped. No crop step here.

module purge
module load 2025

cd $HOME/fork_mmaction2
source .venv/bin/activate

srun python extract_logos_features.py \
    --video_dir   /scratch-shared/psobecki/NGT_dataset/test \
    --output_dir  /scratch-shared/psobecki/Bushuis/logos_features_15fps \
    --checkpoint  $HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth \
    --dataset_name bushuis \
    --frame_interval 4 \
    --workers 5 \
    --batch_size 8
