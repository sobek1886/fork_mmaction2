#!/bin/bash
# Extract frozen-LOGOS features for the regenerated ASL-Citizen Flux augments
# (E4 augmented-vs-original geometry; spec: context/feature-reextraction-spec-2026-07-17.md §2.B).
#
# Frames: augmented_frames_512 — 6000 videos x 4 variants, 512px longest side,
# generated at STRIDE 2 (every 2nd source frame stored) => --frame_interval 1
# keeps temporal parity with originals extracted at --frame_interval 2 (both 15fps).
# --preproc logos_native matches extract_logos_features_native_baseline.job exactly
# (same preprocess_frame code path), so aug-vs-orig deltas carry no framing gap.
# Output goes INTO logos_features_native next to the originals — E1/E2/E3 ignore
# the *_variant files; analyze_augmentation_geometry.py pairs them by filename.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=logos_extract_aug512
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate

# Overridables:
#   AUG_DIRS    space-separated frame batches (default: train 6000 + test 500)
#   OUTPUT_DIR  feature dir (default: frozen logos_features_native)
#   CHECKPOINT  model weights (default: frozen Logos)
#   PREPROC     preprocessing mode (default logos_native; direct224 for the
#               SignCLIP-head feature space in home)
# Intervention-space E4 (augments through a fine-tuned run's checkpoint, into
# that run's feature dir next to its originals):
#   sbatch --time=02:00:00 --job-name=aug_run1 --export=ALL,\
#     OUTPUT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_run1,\
#     CHECKPOINT=/scratch-shared/psobecki/runs/asl_ft_run1/checkpoint_best.pt \
#     extract_logos_features_asl_citizen_aug.job
AUG_DIRS=${AUG_DIRS:-"/scratch-shared/psobecki/ASL_Citizen/augmented_frames_512 /scratch-shared/psobecki/ASL_Citizen/augmented_frames_512_test"}
OUTPUT_DIR=${OUTPUT_DIR:-/scratch-shared/psobecki/ASL_Citizen/logos_features_native}
CHECKPOINT=${CHECKPOINT:-$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth}
PREPROC=${PREPROC:-logos_native}

for AUG_DIR in $AUG_DIRS; do
  echo "=== $AUG_DIR -> $OUTPUT_DIR (ckpt: $CHECKPOINT)"
  srun python extract_logos_features_asl_citizen_aug.py \
    --aug_dir     "$AUG_DIR" \
    --output_dir  "$OUTPUT_DIR" \
    --checkpoint  "$CHECKPOINT" \
    --preproc "$PREPROC" --frame_interval 1 \
    --aug_names glasses shirt_1 signer_swap skin_mst_diffusion \
    --workers 16 --batch_size 8
done

echo "Done. Augment features in $OUTPUT_DIR alongside the originals."
