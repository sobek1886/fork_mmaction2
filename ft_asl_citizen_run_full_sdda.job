#!/bin/bash
# FULL-UNFREEZE SDDA: the third member of the full-unfreeze family, alongside
#   run_full_ce       (CE only)                         — the control
#   run_full_glosscon (CE + gloss-level SupCon)         — gloss-contrastive
#   run_full_sdda     (CE + KL-consistency + GRL disc)  — THIS run (SDDA, Fu et al. 2024)
# IDENTICAL recipe to run_full_ce (full unfreeze, H100 + grad checkpointing, BATCH=24, same
# gloss-balanced paired data path with the aug cap) — the ONLY difference is the auxiliary loss:
# --lambda_kl 1.0 + --lambda_disc 1e-4 instead of SupCon. So the full-unfreeze three-way isolates
# "which auxiliary objective helps at equal depth/capacity".
#
# NOTE: this is the full-unfreeze FAMILY member, matched to run_full_ce/glosscon (batch 24, LR 2e-4,
# gloss-balanced, aug cap). It is NOT a like-for-like depth ablation of the top-2 ft_asl_citizen_-
# run_sdda.job (which uses batch 8, LR 1e-4, regular batching, all augs) — those differ in more
# than depth. The KL/disc losses are per orig-aug pair and indifferent to gloss-balanced batching,
# and with --max_augs_per_item 1 each original still contributes one aug, so both losses fire.

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_run_full_sdda
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=40:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

TAG=run_full_sdda
UNFREEZE=16
LR=2e-4
LLRD=0.9
BATCH=24            # MUST match run_full_ce / run_full_glosscon
PER_GLOSS=2
MAXAUG=1
EPOCHS=10
LAMBDA_KL=1.0       # alpha (SDDA Eq. 6)
LAMBDA_DISC=1e-4    # beta  (SDDA Eq. 7)

CKPT=$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth
VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames
SPLITS=$HOME/ASL_Citizen/splits
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt

srun python train_logos_asl_citizen.py \
    --train_csv      $SPLITS/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES \
    --aug_names      glasses shirt_1 signer_swap skin_mst_diffusion \
    --checkpoint     $CKPT \
    --save_dir       $SAVE_DIR \
    --orig_preproc direct224 --aug_preproc direct224 \
    --paired --gloss_balanced --per_gloss $PER_GLOSS \
    --lambda_supcon 0 --lambda_consist 0 --lambda_kl $LAMBDA_KL --lambda_disc $LAMBDA_DISC \
    --max_augs_per_item $MAXAUG \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD --grad_checkpointing \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum 1 --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG} --slurm_log "$LOGFILE" \
    --val_csv $HOME/ASL_Citizen/splits/val.csv

srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc direct224 --overwrite \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — add 'run_full_sdda' to the eval FEATS map."
RUNID=$(cat $SAVE_DIR/mlflow_run_id.txt 2>/dev/null)
[ -n "$RUNID" ] && python mlflow_log_slurm_log.py "$RUNID" "$LOGFILE" || true
