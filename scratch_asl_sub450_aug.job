#!/bin/bash
# FROM-SCRATCH, AUGMENTED-SUBSET arm AUG-sub: train MViTv2-S with RANDOM INIT on the
# 6,000 augmented parents PLUS their 24,000 Flux augmentations = 30,000 rows, 450-way.
# Paired control: scratch_asl_sub450_ce.job (same 6,000 parents, no augs, 450-way).
#
# WHY: 100% augmentation coverage here vs 15% in the full-set aug run, so this tests
# whether the full-set aug null is a coverage-dilution artifact.
#
# ────────────────────────────────────────────────────────────────────────────────
# READ THIS BEFORE CHANGING --aug_frames_dir
#   ClipDataset resolves an augmented row via
#       fdir = Path(aug_frames_dir)/video_id/aug ;  if not fdir.is_dir(): missing += 1
#   i.e. an unresolvable augmentation is SILENTLY DROPPED, not an error. On 2026-07-20
#   the frame tree behind .../augmented_frames_512 was repacked into 6,000 per-parent
#   .tar files, so every aug row now resolves to nothing. That is why the running
#   full-size "aug" job 24985152 logs
#       [ClipDataset] splits_aug/train.csv: 40154 items (24000 unresolved)
#   — it is training on originals only, i.e. it is a duplicate of the CE arm.
#   (Last good run: 24730895, 2026-07-18, "64154 items (0 unresolved)".)
#   This job therefore points at the RE-EXTRACTED tree built by
#   stage_aug_frames_untar.job, and hard-fails below if it is not populated.
# ────────────────────────────────────────────────────────────────────────────────
#
# LABEL SPACE (450-way):
#   train_logos_asl_citizen.py builds gloss_to_idx from
#       args.train_csv.replace("splits_aug", "splits")
#   ".../splits_aug_sub450/train.csv" -> ".../splits_sub450/train.csv", i.e. the CE-sub
#   arm's 6,000-row parent file. Both arms therefore get IDENTICAL 450-way label
#   indices. Head width is the separate --num_classes flag, passed as 450 below.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=sub450_aug
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=25:00:00              # est. 23.3 GPU-h (20 ep x 30,000 clips = 20.6 h at
                                     # the MEASURED 0.124 s/clip, + 2.7 h extract).
                                     # Limit also caps spend at 3,200 SBU. If the run
                                     # walls out, checkpoint_best.pt is still written
                                     # every time val improves — only the extract srun
                                     # is lost and can be re-run separately.
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1

# ── run config (identical to scratch_asl_citizen_aug.job EXCEPT epochs, see note) ─
TAG=sub450_aug
UNFREEZE=16
LR=1e-3
LLRD=1.0
BATCH=6
GRAD_ACCUM=4
EPOCHS=20            # DEVIATION from the template's 30, forced by measured throughput
                     # (0.124 s/clip): 30 epochs would put the CE-sub + AUG-sub pair at
                     # ~5,490 SBU, over the 4,500 hard cap. Both sub450 arms use 20, so
                     # the CE-sub vs AUG-sub contrast stays exactly matched.
NUM_CLASSES=450

SPLITS_AUG=$HOME/ASL_Citizen/splits_aug_sub450

VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames_512_x   # EXTRACTED tree
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt

# ── pre-flight: splits ───────────────────────────────────────────────────────
for f in train val test; do
    [ -f "$SPLITS_AUG/$f.csv" ] || { echo "FATAL: missing $SPLITS_AUG/$f.csv"; exit 1; }
done
NTRAIN=$(($(wc -l < $SPLITS_AUG/train.csv) - 1))
echo "[pre-flight] aug train rows=$NTRAIN (expect 30000)"
[ "$NTRAIN" -eq 30000 ] || { echo "FATAL: train.csv is $NTRAIN rows, expected 30000"; exit 1; }

# ── pre-flight: the augmentation frame tree MUST be extracted ────────────────
# Without this the run silently degenerates into the CE arm (see header).
NLEAF=$(find "$AUG_FRAMES" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | wc -l)
echo "[pre-flight] aug leaf dirs under $AUG_FRAMES = $NLEAF (expect 24000)"
if [ "$NLEAF" -lt 24000 ]; then
    echo "FATAL: augmentation frames are not extracted (found $NLEAF of 24000 leaf dirs)."
    echo "       Run stage_aug_frames_untar.job first. Refusing to train, because"
    echo "       ClipDataset would silently drop the augmented rows and this arm would"
    echo "       become an exact duplicate of scratch_asl_sub450_ce.job."
    exit 1
fi

# ── synthesise the empty (backbone-key-less) checkpoint for random init ───────
EMPTY_CKPT=$HOME/fork_mmaction2/data/model/EMPTY_random_init.pth
if [ ! -f "$EMPTY_CKPT" ]; then
    python -c "import torch, os; os.makedirs(os.path.dirname('$EMPTY_CKPT'), exist_ok=True); torch.save({'state_dict': {}}, '$EMPTY_CKPT')"
    echo "[random-init] wrote empty checkpoint $EMPTY_CKPT (loads no weights)"
fi

# ── train (random init + aug-as-data, 100% aug coverage, 450-way) ────────────
# EXPECT in the log: "[ClipDataset] .../splits_aug_sub450/train.csv: 30000 items
# (0 unresolved)". Anything less means augmentations are being dropped.
srun python train_logos_asl_citizen.py \
    --train_csv      $SPLITS_AUG/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES --aug_frame_interval 1 \
    --aug_names glasses shirt_1 signer_swap skin_mst_diffusion \
    --checkpoint     $EMPTY_CKPT \
    --save_dir       $SAVE_DIR \
    --num_classes    $NUM_CLASSES \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum $GRAD_ACCUM --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG} --slurm_log "$LOGFILE" \
    --val_csv $SPLITS_AUG/val.csv

# ── re-extract all videos with the from-scratch checkpoint (Eval A + Eval B) ─
srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc logos_native --overwrite \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — eval with eval_asl_citizen_features.job (MMPT venv, genoa),"
echo "pointed at $SPLITS_AUG/test.csv (450-gloss subset), NOT the full test split."

RUNID=$(cat $SAVE_DIR/mlflow_run_id.txt 2>/dev/null)
[ -n "$RUNID" ] && python mlflow_log_slurm_log.py "$RUNID" "$LOGFILE" || true
