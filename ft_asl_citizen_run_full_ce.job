#!/bin/bash
# MATCHED CE control for ft_asl_citizen_run_full_glosscon.job. IDENTICAL recipe — full unfreeze,
# same H100 + grad checkpointing, same BATCH=24, same gloss-balanced paired data path with the
# aug cap — EXCEPT --lambda_supcon 0 (no contrastive term). So:
#     run_full_glosscon  −  run_full_ce  =  the gloss-contrastive loss's contribution, isolated.
# It also answers "does full unfreeze beat the top-6 CE run (run2_mid)?". Keep BATCH / EPOCHS /
# grad_checkpointing IN SYNC with run_full_glosscon, or the comparison is confounded.
# (The trainer will print a benign "[WARN] --gloss_balanced set but --lambda_supcon=0" — that is
# intended here: we want CE on the same class-balanced+aug batches, just without SupCon.)

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_run_full_ce
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=40:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

TAG=run_full_ce
UNFREEZE=16
LR=2e-4
LLRD=0.9
BATCH=24            # MUST match run_full_glosscon
PER_GLOSS=2
MAXAUG=1
EPOCHS=10
LAMBDA_SUPCON=0     # the ONLY difference from run_full_glosscon

CKPT=$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth
VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
AUG_FRAMES=/scratch-shared/psobecki/ASL_Citizen/augmented_frames_512
SPLITS=$HOME/ASL_Citizen/splits
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt

srun python train_logos_asl_citizen.py \
    --train_csv      $SPLITS/train.csv \
    --video_dir      $VIDEO_DIR \
    --aug_frames_dir $AUG_FRAMES --aug_frame_interval 1 \
    --aug_names      glasses shirt_1 signer_swap skin_mst_diffusion \
    --checkpoint     $CKPT \
    --save_dir       $SAVE_DIR \
    --orig_preproc logos_native --aug_preproc logos_native \
    --paired --gloss_balanced --per_gloss $PER_GLOSS --lambda_supcon $LAMBDA_SUPCON \
    --max_augs_per_item $MAXAUG \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD --grad_checkpointing \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum 1 --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG} --slurm_log "$LOGFILE" \
    --val_csv $HOME/ASL_Citizen/splits/val.csv

srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc logos_native --overwrite \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — 'run_full_ce' is registered in eval_asl_citizen_features.job."
RUNID=$(cat $SAVE_DIR/mlflow_run_id.txt 2>/dev/null)
[ -n "$RUNID" ] && python mlflow_log_slurm_log.py "$RUNID" "$LOGFILE" || true
