#!/bin/bash
# FULL end-to-end fine-tune, CE only (control / capacity ceiling). Unfreeze ALL 16 MViT blocks
# (supervisor: don't worry about catastrophic forgetting — pretrain vs FT data scale is close).
# Mild layer-wise LR decay + low base LR for stability. Matched CE control for
# ft_asl_citizen_run_full_glosscon.job — tells you whether the gloss-contrastive term adds
# anything at full capacity. Preprocessing: direct224 (matches the run2_mid/run1_mid family).

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=ft_asl_run_full_ce
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00
#SBATCH --output=/home/psobecki/fork_mmaction2/jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/fork_mmaction2
source .venv/bin/activate
export PYTHONUNBUFFERED=1

TAG=run_full_ce
UNFREEZE=16          # full backbone
LR=2e-4
LLRD=0.9             # mild decay; early blocks still move (forgetting acceptable per supervisor)
BATCH=6              # full FT is activation-heavy; lower if OOM
GRAD_ACCUM=3         # effective batch 18
EPOCHS=12

CKPT=$HOME/fork_mmaction2/data/model/logos_autsl_wlasl_model.pth
VIDEO_DIR=/scratch-shared/psobecki/ASL_Citizen/videos
SPLITS=$HOME/ASL_Citizen/splits
SAVE_DIR=/scratch-shared/psobecki/runs/asl_ft_${TAG}
FEAT_DIR=/scratch-shared/psobecki/ASL_Citizen/logos_features_${TAG}
LOGFILE=/home/psobecki/fork_mmaction2/jobs/output/slurm_${SLURM_JOB_NAME}_${SLURM_JOB_ID}.txt

srun python train_logos_asl_citizen.py \
    --train_csv  $SPLITS/train.csv \
    --video_dir  $VIDEO_DIR \
    --checkpoint $CKPT \
    --save_dir   $SAVE_DIR \
    --orig_preproc direct224 \
    --unfreeze_blocks $UNFREEZE --llrd $LLRD \
    --epochs $EPOCHS --batch_size $BATCH --grad_accum $GRAD_ACCUM --lr $LR \
    --workers 16 \
    --mlflow --mlflow_run_name asl_ft_${TAG} --slurm_log "$LOGFILE" \
    --val_csv $HOME/ASL_Citizen/splits/val.csv

srun python extract_logos_features.py \
    --video_dir   $VIDEO_DIR \
    --output_dir  $FEAT_DIR \
    --checkpoint  $SAVE_DIR/checkpoint_best.pt \
    --dataset_name asl_citizen \
    --preproc direct224 --overwrite \
    --workers 16 --batch_size 8

echo "Done. Features in $FEAT_DIR — add 'run_full_ce' to eval_asl_citizen_features.job FEATS."
RUNID=$(cat $SAVE_DIR/mlflow_run_id.txt 2>/dev/null)
[ -n "$RUNID" ] && python mlflow_log_slurm_log.py "$RUNID" "$LOGFILE" || true
